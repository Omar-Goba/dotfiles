\newcommand{\tb}[2]{\begin{center}\begin{tabular}{#1}#2\end{tabular}\end{center}}
\newcommand{\del}[2]{\frac{\partial #1}{\partial #2}}
\newcommand{\der}[2]{\frac{d #1}{d #2}}
\newcommand{\ihat}{\hat\imath}\newcommand{\jhat}{\hat\jmath}\newcommand{\khat}{\hat k}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\newcommand{\mtrx}[1]{\begin{matrix}#1\end{matrix}}
\newcommand{\bmtrx}[1]{\begin{bmatrix}#1\end{bmatrix}}
