\newcommand{\bimg}[1]{\begin{figure}[!htb]\center\includegraphics[width=0.5\textwidth]{#1}\end{figure}}
\newcommand{\simg}[1]{\begin{figure}[!htb]\center\includegraphics[width=0.2\textwidth]{#1}\end{figure}}
\newcommand{\imgz}[2]{\begin{minipage}[t]{.45\linewidth}\includegraphics[width=\linewidth]{#1}\end{minipage}\hfill\begin{minipage}[b]{.45\linewidth}\includegraphics[width=\linewidth]{#2}\end{minipage}}
